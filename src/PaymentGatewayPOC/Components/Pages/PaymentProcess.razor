@page "/payment-process/{TransactionIdParam:guid}"
@rendermode InteractiveServer
@using PaymentGatewayPOC.Services.Interfaces
@using PaymentGatewayPOC.Models
@inject NavigationManager NavigationManager
@inject ITransactionService TransactionService

<PageTitle>Payment Process</PageTitle>

<h3>Payment Process</h3>

<div class="mb-3">
    <label for="transactionId" class="form-label">Transaction ID</label>
    <div id="transactionId" class="form-control" style="background-color: #e9ecef;">@TransactionId</div>
</div>

<div class="mb-3">
    <label for="amount" class="form-label">Amount</label>
    <div id="amount" class="form-control" style="background-color: #e9ecef;">@Amount.ToString("C")</div>
</div>

<div class="mb-3">
    <label for="errorMsg" class="form-label">Error</label>
    <label for="errorMsg" class="form-label">@ErrorMsg</label>
</div>

<div class="button-group">
    <button class="btn btn-success" @onclick="OnCompletedAsync">Completed</button>
    <button class="btn btn-danger" @onclick="OnFailedAsync">Failed</button>
    <button class="btn btn-warning" @onclick="OnCancelledAsync">Cancelled</button>
</div>

@code {
    [Parameter]
    public Guid TransactionIdParam { get; set; }

    private Guid TransactionId { get; set; }
    private decimal Amount { get; set; } = 0m;

    private string ErrorMsg { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Transaction? transaction = await TransactionService.GetTransactionByIdAsync(TransactionIdParam);
            if (transaction == null || transaction.Status != TransactionStatus.Pending)
            {
                ErrorMsg = "Transaction not found or not in pending status.";
                return;
            }
            await TransactionService.UpdateTransactionStatusAsync(transaction.TransactionId, DateTime.UtcNow, TransactionStatus.InPayment);
            TransactionId = transaction.TransactionId;
            Amount = transaction?.Amount ?? 0m;
        }
        catch (Exception ex)
        {
            ErrorMsg = $"Error loading transaction: {ex.Message}";
            return;
        }
    }

    private async Task OnCompletedAsync()
    {
        await TransactionService.UpdateTransactionStatusAsync(TransactionId, DateTime.UtcNow, TransactionStatus.Paid);
        NavigationManager.NavigateTo($"/payment-status/{TransactionId}");
    }

    private async Task OnFailedAsync()
    {
        await TransactionService.UpdateTransactionStatusAsync(TransactionId, DateTime.UtcNow, TransactionStatus.Failed);
        NavigationManager.NavigateTo($"/payment-status/{TransactionId}");
    }

    private async Task OnCancelledAsync()
    {
        await TransactionService.UpdateTransactionStatusAsync(TransactionId, DateTime.UtcNow, TransactionStatus.Cancelled);
        NavigationManager.NavigateTo($"/payment-status/{TransactionId}");
    }
}
