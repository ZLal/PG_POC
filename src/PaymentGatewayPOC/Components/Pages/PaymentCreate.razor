@page "/payment-create"
@using PaymentGatewayPOC.Models
@using PaymentGatewayPOC.Services.Interfaces
@inject NavigationManager NavigationManager
@inject IClientService ClientService
@inject ITransactionService TransactionService
@inject IApplicationService ApplicationService

<PageTitle>Payment Create</PageTitle>

<h3>Payment Create</h3>

<div class="mb-3">
    <label for="clientId" class="form-label">Client ID</label>
    <InputText id="clientId" class="form-control" @bind-Value="ClientId" />
</div>

<div class="mb-3">
    <label for="clientSecret" class="form-label">Client Secret</label>
    <InputText id="clientSecret" class="form-control" @bind-Value="ClientSecret" />
</div>

<div class="mb-3">
    <label for="amount" class="form-label">Amount</label>
    <InputNumber id="amount" TValue="decimal" class="form-control" @bind-Value="Amount" />
</div>

<div class="mb-3">
    <label for="errorMsg" class="form-label">Error</label>
    <label for="errorMsg" class="form-label">@ErrorMsg</label>
</div>

<button class="btn btn-primary" @onclick="SubmitAsync">Submit</button>

@code {
    private string ClientId { get; set; } = string.Empty;
    private string ClientSecret { get; set; } = string.Empty;
    private decimal Amount { get; set; }
    private string ErrorMsg { get; set; } = string.Empty;

    private async Task SubmitAsync()
    {
        Client? client = await ClientService.GetClientBySecretKeyAsync(Guid.Parse(ClientId), ClientSecret);
        if (client == null)
        {
            ErrorMsg = "Invalid client credentials.";
            return;
        }

        Application? application = await ApplicationService.GetApplicationWithActiveGatewayAsync(client.ApplicationId);
        if (application == null || application.ApplicationGateways == null)
        {
            ErrorMsg = "Application not found or no active gateway available.";
            return;
        }

        Guid transactionId;
        try
        {
            Transaction? transaction = await TransactionService.CreateTransactionAsync(
                application.ApplicationId,
                application.ApplicationGateways.First().GatewayId,
                Amount
            );
            transactionId = transaction.TransactionId;
        }
        catch (Exception ex)
        {
            ErrorMsg = $"Error creating transaction: {ex.Message}";
            return;
        }

        NavigationManager.NavigateTo($"/payment-process?TransactionIdParam={transactionId}");
        return;
    }
}
