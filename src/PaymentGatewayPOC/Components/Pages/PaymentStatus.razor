@page "/payment-status/{TransactionIdParam:guid}"
@using PaymentGatewayPOC.Services.Interfaces
@using PaymentGatewayPOC.Models
@inject NavigationManager NavigationManager
@inject ITransactionService TransactionService

<PageTitle>Payment Status</PageTitle>

<h3>Payment Status</h3>

<div class="mb-3">
    <label for="transactionId" class="form-label">Transaction ID</label>
    <div id="transactionId" class="form-control" style="background-color: #e9ecef;">@TransactionId</div>
</div>

<div class="mb-3">
    <label for="amount" class="form-label">Amount</label>
    <div id="amount" class="form-control" style="background-color: #e9ecef;">@Amount.ToString("C")</div>
</div>

<div class="mb-3">
    <label for="status" class="form-label">Status</label>
    <div id="status" class="form-control" style="background-color: #e9ecef;">@Status.ToString()</div>
</div>

<div class="mb-3">
    <label for="errorMsg" class="form-label">Error</label>
    <label for="errorMsg" class="form-label">@ErrorMsg</label>
</div>

@code {
    [Parameter]
    public Guid TransactionIdParam { get; set; }

    private Guid TransactionId { get; set; }
    private decimal Amount { get; set; } = 0m;
    private TransactionStatus Status { get; set; } = TransactionStatus.Pending;

    private string ErrorMsg { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        TransactionId = TransactionIdParam;
        try
        {
            Transaction? transaction = await TransactionService.GetTransactionByIdAsync(TransactionId);
            if (transaction == null)
            {
                ErrorMsg = "Transaction not found.";
                return;
            }
            Amount = transaction.Amount;
            Status = transaction.Status;
        }
        catch (Exception ex)
        {
            ErrorMsg = $"Error loading transaction: {ex.Message}";
            return;
        }
    }
}
